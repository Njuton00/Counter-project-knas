<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.MainPage"
             Title="Counter">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Counter"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <VerticalStackLayout x:Name="CountersLayout"
                                 Spacing="10">
            </VerticalStackLayout>

            <BoxView HeightRequest="1"
                     Color="Gray" />

            <Label Text="Add new counter"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Entry x:Name="NameEntry"
                   Placeholder="Counter name" />

            <Entry x:Name="ValueEntry"
                   Placeholder="Initial value"
                   Keyboard="Numeric"
                   Text="0" />

            <Picker x:Name="ColorPicker"
                    Title="Choose background color"
                    SelectedIndex="0">
                    <Picker.Items>
                        <x:String>Blue</x:String>
                        <x:String>Green</x:String>
                        <x:String>Red</x:String>
                        <x:String>Purple</x:String>
                        <x:String>Gray</x:String>
                    </Picker.Items>
            </Picker>

            <Button Text="Add counter"
                    Clicked="AddCounter_Clicked"
                    BackgroundColor="#398A55"
                    TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
